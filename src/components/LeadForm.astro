---
import { project } from "../data/project";
import { withBase } from "../lib/url";

const email = project.contactEmail.trim();
---

{
  email && (
    <form class="form" data-lead-form data-email={email} novalidate={false}>
      <label>
        Họ tên
        <input name="name" autocomplete="name" required maxlength="120" />
      </label>
      <label>
        Số điện thoại
        <input name="phone" type="tel" autocomplete="tel" required maxlength="30" />
      </label>
      <label>
        Nội dung
        <textarea name="message" rows="4" maxlength="1000" />
      </label>
      <button class="button" type="submit">Mở email soạn sẵn</button>
      <p class="form-status" data-form-status role="status"></p>
      <p class="source-note">
        Biểu mẫu không lưu trên máy chủ. Trình thư của bạn sẽ mở với địa chỉ {email}. Thông tin chỉ được gửi khi bạn bấm gửi trong ứng dụng thư.
        Xem <a href={withBase("privacy")}>chính sách riêng tư</a>.
      </p>
    </form>
  )
}
