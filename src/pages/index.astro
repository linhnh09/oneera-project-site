---
import AmenitiesGallery from "../components/AmenitiesGallery.astro";
import AwardsSection from "../components/AwardsSection.astro";
import ContactBar from "../components/ContactBar.astro";
import ContactSection from "../components/ContactSection.astro";
import CoreValues from "../components/CoreValues.astro";
import DeveloperSection from "../components/DeveloperSection.astro";
import HeroSection from "../components/HeroSection.astro";
import LandmarkSection from "../components/LandmarkSection.astro";
import NewsSection from "../components/NewsSection.astro";
import PanoramaSection from "../components/PanoramaSection.astro";
import PartnersSection from "../components/PartnersSection.astro";
import ProjectOverview from "../components/ProjectOverview.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { project } from "../data/project";
---

<BaseLayout
  title={project.pageTitle}
  description={project.metaDescription}
  preloadImage="images/hero/skyline.webp"
>
  <SiteHeader />
  <main id="noi-dung">
    <HeroSection />
    <ProjectOverview />
    <CoreValues />
    <LandmarkSection />
    <AmenitiesGallery />
    <PanoramaSection />
    <DeveloperSection />
    <AwardsSection />
    <NewsSection />
    <PartnersSection />
    <ContactSection />
  </main>
  <SiteFooter />
  <ContactBar />
</BaseLayout>
